---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PackageDetailPage } from "../../components/pages/PackageDetailPage";
import { PACKAGES, getPackageBySlug } from "../../data";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  touristTripJsonLd,
} from "../../lib/seo";
import { resolvePackage } from "../../lib/resolveMedia";

export function getStaticPaths() {
  return PACKAGES.map((pkg) => ({
    params: { slug: pkg.slug },
  }));
}

const { slug } = Astro.params;
const source = getPackageBySlug(slug ?? "");

if (!source) {
  return Astro.redirect("/paquetes");
}

const pkg = await resolvePackage(source, "detail");
const pathname = `/paquetes/${pkg.slug}`;
const cover = pkg.images[0]!;
const ogUrl = absoluteUrl(cover.src);
const jsonLd = [
  touristTripJsonLd(source, ogUrl),
  breadcrumbJsonLd([
    { label: "Inicio", path: "/" },
    { label: "Paquetes", path: "/paquetes" },
    { label: pkg.name, path: pathname },
  ]),
];
---

<BaseLayout
  title={pkg.name}
  description={pkg.summary}
  pathname={pathname}
  ogImage={ogUrl}
  ogImageAlt={cover.alt}
  ogImageWidth={cover.width}
  ogImageHeight={cover.height}
  jsonLd={jsonLd}
>
  <PackageDetailPage client:load pkg={pkg} />
</BaseLayout>
