---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PackagesPage } from "../../components/pages/PackagesPage";
import { absoluteUrl, breadcrumbJsonLd } from "../../lib/seo";
import { resolveAllPackages } from "../../lib/resolveMedia";

const title = "Paquetes Chepe Express y Barrancas del Cobre";
const description =
  "Paquetes de 3 a 7 días por la Sierra Tarahumara: Barrancas Express, Pueblos Mágicos, Altura y Aventura, Cultural, Espectacular y Maravillosa.";
const breadcrumbs = breadcrumbJsonLd([
  { label: "Inicio", path: "/" },
  { label: "Paquetes", path: "/paquetes" },
]);
const packages = await resolveAllPackages();
const cover = packages[0]?.images[0];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/paquetes"
  ogImage={cover ? absoluteUrl(cover.src) : undefined}
  ogImageAlt={cover?.alt}
  ogImageWidth={cover?.width}
  ogImageHeight={cover?.height}
  jsonLd={breadcrumbs}
>
  <PackagesPage client:load packages={packages} />
</BaseLayout>
