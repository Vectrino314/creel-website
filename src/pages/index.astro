import { HomePage } from "../components/pages/HomePage";
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE } from "../site";
import { travelAgencyJsonLd } from "../lib/seo";
---

<BaseLayout
  title={DEFAULT_TITLE}
