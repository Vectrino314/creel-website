---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DestinationsPage } from "../../components/pages/DestinationsPage";
import { absoluteUrl, breadcrumbJsonLd } from "../../lib/seo";
import { resolveAllDestinations } from "../../lib/resolveMedia";

const title = "Destinos en Barrancas del Cobre y Chihuahua";
const description =
  "Explora Divisadero, Creel, Chihuahua Capital, Cuauhtémoc y El Fuerte. Destinos de naturaleza, cultura y aventura con Incentitours.";
const breadcrumbs = breadcrumbJsonLd([
  { label: "Inicio", path: "/" },
  { label: "Destinos", path: "/destinos" },
]);
const destinations = await resolveAllDestinations();
const cover = destinations[0]?.images[0];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/destinos"
  ogImage={cover ? absoluteUrl(cover.src) : undefined}
  ogImageAlt={cover?.alt}
  ogImageWidth={cover?.width}
  ogImageHeight={cover?.height}
  jsonLd={breadcrumbs}
>
  <DestinationsPage client:load destinations={destinations} />
</BaseLayout>
