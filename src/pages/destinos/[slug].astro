---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DestinationDetailPage } from "../../components/pages/DestinationDetailPage";
import { DESTINATIONS, getDestinationBySlug } from "../../data";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  touristDestinationJsonLd,
} from "../../lib/seo";
import { resolveDestination } from "../../lib/resolveMedia";

export function getStaticPaths() {
  return DESTINATIONS.map((destination) => ({
    params: { slug: destination.slug },
  }));
}

const { slug } = Astro.params;
const source = getDestinationBySlug(slug ?? "");

if (!source) {
  return Astro.redirect("/destinos");
}

const destination = await resolveDestination(source, "detail");
const title = destination.featuredTitle ?? destination.name;
const description = destination.blurb;
const pathname = `/destinos/${destination.slug}`;
const cover = destination.images[0]!;
const ogUrl = absoluteUrl(cover.src);
const jsonLd = [
  touristDestinationJsonLd(source, ogUrl),
  breadcrumbJsonLd([
    { label: "Inicio", path: "/" },
    { label: "Destinos", path: "/destinos" },
    { label: destination.name, path: pathname },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname={pathname}
  ogImage={ogUrl}
  ogImageAlt={cover.alt}
  ogImageWidth={cover.width}
  ogImageHeight={cover.height}
  jsonLd={jsonLd}
>
  <DestinationDetailPage client:load destination={destination} />
</BaseLayout>
